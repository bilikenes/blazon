{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blazon",
  "version": "../package.json",
  "identifier": "io.github.bilikenes.blazon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blazon",
        "width": 980,
        "height": 660,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Enes Bilik",
    "copyright": "© 2026 Enes Bilik. MIT Lisansı.",
    "category": "Utility",
    "shortDescription": "Windows klasör ikonlarını renklendir",
    "longDescription": "Blazon, Windows klasörlerine renk ve sembol ekleyerek onları kolayca ayırt etmeni sağlar. Klasörü sürükle, rengini ve sembolünü seç, uygula.",
    "homepage": "https://github.com/bilikenes/blazon",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBNjI2RjU3OTUyMkQwNTgKUldSWTBDS1ZWMjlpaW5JV3BDOUNYRmF4bjZtZHRqMmpmdHlQVmpzWERZUWE2K1NUL3VydVJvQVYK",
      "endpoints": [
        "https://github.com/bilikenes/blazon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
